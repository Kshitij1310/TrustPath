# ---- Server ----
PORT=4000
NODE_ENV=development

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ---- Auth ----
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database (PostgreSQL + PostGIS) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustroute
# Set to true only when connecting to a managed/hosted Postgres that requires TLS
DATABASE_SSL=false

# ---- Routing provider (free / public OSRM demo server) ----
# Public demo server has usage limits — replace with a self-hosted OSRM later.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a User-Agent that identifies you with REAL
# contact details. Placeholder domains are actively blocked — a UA containing
# "example.com" gets a 403, so put your own email or project URL here.
GEOCODER_USER_AGENT=TrustRoute/0.1 (your-email@your-domain.com)

# ---- Risk engine tuning ----
SEGMENT_LENGTH_METERS=500
INCIDENT_RADIUS_METERS=500

# ---- Journey guardian ----
# How far off the planned route counts as a deviation
DEVIATION_THRESHOLD_METERS=250
# Grace period after ETA before a journey is treated as overdue
OVERDUE_GRACE_MINUTES=10

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
