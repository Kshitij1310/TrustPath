{
  "name": "trustroute-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TrustRoute API \u2014 safety navigation, journey guardian and emergency workflow",
  "main": "src/server.js",
  "scripts": {
    "dev": "node api.js && node --watch src/server.js",
    "start": "node api.js && node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:import:osm": "node src/db/import-osm.js",
    "db:import:crime": "node src/db/import-crime.js",
    "db:seed:demo": "node src/db/seed-demo.js",
    "db:status": "node src/db/status.js",
    "test": "node --test --env-file=tests/test.env tests/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  }
}
