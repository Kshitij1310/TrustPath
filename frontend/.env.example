# Both are optional in development.
#
# Vite proxies /api and /socket.io to http://localhost:4000 (see vite.config.js),
# so the app talks to the backend on its own origin — same as it will behind a
# reverse proxy in production. Set these only when the API lives elsewhere.

# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com
